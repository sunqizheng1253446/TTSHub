# TTS Hub 配置文件示例
# 复制此文件为 config.yaml 并根据实际情况修改配置

server:
  # 服务监听端口
  port: 8080
  # 服务监听地址
  host: "0.0.0.0"
  # 超时设置（秒）
  read_timeout: 30
  write_timeout: 30
  idle_timeout: 60

storage:
  # SQLite数据库文件路径
  db_path: "ttshub.db"
  # 最大空闲连接数
  max_idle_connections: 5
  # 最大打开连接数
  max_open_connections: 25

logging:
  # 日志级别: debug, info, warn, error
  level: "info"
  # 日志格式: json, text
  format: "json"
  # 是否输出到文件
  output_file: ""
  # 是否输出到控制台
  output_console: true

cors:
  # 允许的源，使用 * 表示允许所有
  allowed_origins: ["*"]
  # 允许的HTTP方法
  allowed_methods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
  # 允许的请求头
  allowed_headers: ["Origin", "Content-Type", "Accept", "Authorization"]
  # 是否允许凭证
  allow_credentials: true
  # 预检请求的有效期（秒）
  max_age: 86400

security:
  # API密钥验证（如果启用）
  enable_api_key: false
  # 默认的API密钥（仅用于测试）
  default_api_key: "your-api-key-here"

# 默认渠道配置（可选）
default_channels:
  # 是否启用默认OpenAI渠道
  enable_openai_default: false
  openai_config:
    api_key: "sk-your-openai-api-key"
    model: "tts-1"
    voice: "alloy"
    temperature: 0.0